<idea-plugin>
    <id>io.github.acalebratliff.dotstudio</id>
    <name>DOT Studio</name>
    <vendor url="https://github.com/acalebratliff">acalebratliff</vendor>

    <description><![CDATA[
    Support for Graphviz DOT files (<code>.dot</code>, <code>.gv</code>). In development; syntax highlighting, syntax error highlighting, folding, structure view, brace matching and commenting are available.
    <p>Planned for the first release:</p>
    <ul>
        <li>A live preview in a split editor that renders in the background, with zoom, pan and a layout engine picker</li>
        <li>A bundled renderer, so no Graphviz installation is needed</li>
        <li>SVG and PNG export</li>
    </ul>
    <p>Source code and issue tracker: <a href="https://github.com/acalebratliff/dot-studio">github.com/acalebratliff/dot-studio</a></p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <!-- From 2026.2 JCEF is a separate plugin, and this dependency puts its classes on our class path. 2025.2 has
         JCEF in the core and no such module, so the config file never loads there: preview registrations belong
         in this file, not in dot-studio-jcef.xml. -->
    <depends optional="true" config-file="dot-studio-jcef.xml">com.intellij.modules.jcef</depends>

    <resource-bundle>messages.DotStudioBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <fileType name="DotStudio" language="DotStudio" extensions="dot;gv" fieldName="INSTANCE"
                  implementationClass="io.github.acalebratliff.dotstudio.lang.DotFileType"/>
        <lang.parserDefinition language="DotStudio"
                               implementationClass="io.github.acalebratliff.dotstudio.lang.DotParserDefinition"/>
        <lang.syntaxHighlighterFactory language="DotStudio"
                                       implementationClass="io.github.acalebratliff.dotstudio.lang.DotSyntaxHighlighterFactory"/>
        <colorSettingsPage implementation="io.github.acalebratliff.dotstudio.lang.DotColorSettingsPage"/>
        <lang.commenter language="DotStudio" implementationClass="io.github.acalebratliff.dotstudio.lang.DotCommenter"/>
        <lang.braceMatcher language="DotStudio" implementationClass="io.github.acalebratliff.dotstudio.lang.DotBraceMatcher"/>
        <lang.foldingBuilder language="DotStudio"
                             implementationClass="io.github.acalebratliff.dotstudio.lang.DotFoldingBuilder"/>
        <lang.psiStructureViewFactory language="DotStudio"
                                      implementationClass="io.github.acalebratliff.dotstudio.lang.DotStructureViewFactory"/>
        <annotator language="DotStudio" implementationClass="io.github.acalebratliff.dotstudio.lang.DotAnnotator"/>
        <fileEditorProvider implementation="io.github.acalebratliff.dotstudio.preview.DotSplitEditorProvider"/>
    </extensions>

    <applicationListeners>
        <listener class="io.github.acalebratliff.dotstudio.DotUnloadListener"
                  topic="com.intellij.ide.plugins.DynamicPluginListener"/>
    </applicationListeners>

    <actions>
        <!-- The id is ZOOM_GROUP_ID in DotSplitEditor.kt, which puts this group on the split editor's toolbar. -->
        <group id="DotStudio.PreviewZoom">
            <action id="DotStudio.ZoomIn" class="io.github.acalebratliff.dotstudio.preview.ZoomInAction" icon="AllIcons.General.ZoomIn"/>
            <action id="DotStudio.ZoomOut" class="io.github.acalebratliff.dotstudio.preview.ZoomOutAction" icon="AllIcons.General.ZoomOut"/>
            <action id="DotStudio.ActualSize" class="io.github.acalebratliff.dotstudio.preview.ActualSizeAction" icon="AllIcons.General.ActualZoom"/>
            <action id="DotStudio.ZoomToFit" class="io.github.acalebratliff.dotstudio.preview.ZoomToFitAction" icon="AllIcons.General.FitContent"/>
        </group>
        <!-- The id is EXPORT_GROUP_ID in DotSplitEditor.kt, which puts this group on the split editor's toolbar. -->
        <group id="DotStudio.PreviewExport" class="io.github.acalebratliff.dotstudio.preview.ExportGroup" popup="true" icon="AllIcons.ToolbarDecorator.Export">
            <action id="DotStudio.ExportSvg" class="io.github.acalebratliff.dotstudio.preview.ExportSvgAction"/>
            <action id="DotStudio.ExportPng1x" class="io.github.acalebratliff.dotstudio.preview.ExportPng1xAction"/>
            <action id="DotStudio.ExportPng2x" class="io.github.acalebratliff.dotstudio.preview.ExportPng2xAction"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </group>
    </actions>
</idea-plugin>
